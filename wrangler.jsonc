{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sootdestroyer",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sootdestroyer-bookings"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS"
    }
  ]
}
